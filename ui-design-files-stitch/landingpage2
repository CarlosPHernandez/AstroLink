<script>
        const states = ['text', 'video', 'call'];
        let currentIndex = 0;

        const container = document.getElementById('cycle-container');
        const elements = {
            text: document.getElementById('state-text'),
            video: document.getElementById('state-video'),
            call: document.getElementById('state-call')
        };
        const triggers = {
            text: document.getElementById('trigger-text'),
            video: document.getElementById('trigger-video'),
            call: document.getElementById('trigger-call')
        };
        const indicators = {
            text: document.getElementById('indicator-text'),
            video: document.getElementById('indicator-video'),
            call: document.getElementById('indicator-call')
        };

        function updateStage(index) {
            const prevState = states[currentIndex];
            const newState = states[index];

            // Hide all states
            Object.values(elements).forEach(el => {
                el.classList.add('hidden');
                el.classList.remove('fade-slide-up');
            });

            // Show active state
            elements[newState].classList.remove('hidden');
            elements[newState].classList.add('fade-slide-up');

            // Update triggers
            Object.entries(triggers).forEach(([key, el]) => {
                if (key === newState) {
                    el.classList.remove('opacity-30');
                    el.classList.add('opacity-100');
                    indicators[key].classList.remove('hidden');
                } else {
                    el.classList.add('opacity-30');
                    el.classList.remove('opacity-100');
                    indicators[key].classList.add('hidden');
                }
            });

            currentIndex = index;
        }

        // Auto-cycle logic
        let autoCycle = setInterval(() => {
            let next = (currentIndex + 1) % states.length;
            updateStage(next);
        }, 6000);

        // Click interaction
        Object.entries(triggers).forEach(([key, el], idx) => {
            el.addEventListener('click', () => {
                clearInterval(autoCycle);
                updateStage(idx);
            });
        });
    </script>
