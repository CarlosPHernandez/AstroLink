# =============================================================================
# AstroLink — copy to .env.local and fill in values
# Supabase project: AstroLink (ref vwoizjesyyygmokfqpyy)
# Dashboard: https://supabase.com/dashboard/project/vwoizjesyyygmokfqpyy
# =============================================================================

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://vwoizjesyyygmokfqpyy.supabase.co
# Publishable (recommended) or legacy anon key — client-safe only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only (agents, API routes). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical app URL for auth redirects and Stripe return URLs.
# Production: https://astro-link.space | Preview: leave unset (uses VERCEL_URL)
NEXT_PUBLIC_APP_URL=

# --- App mode (production waitlist: APP_MODE=waitlist) ---
# waitlist = public /early-access only; full = dev/booking surfaces
APP_MODE=full

# Chris Sembroski limited booking (opens funnel under APP_MODE=waitlist; Vercel Production only)
# CHRIS_BOOKING_ENABLED=true
# CHRIS_SLOT_CAP=10
# CHRIS_MENTOR_SLUG=chris-sembroski
# CHRIS_CAMPAIGN_ID=chris-sembroski
# Optional Stripe discount for Chris campaign checkout (sandbox promo/coupon)
# CHRIS_STRIPE_COUPON_ID=coupon_...
# CHRIS_STRIPE_PROMOTION_CODE=CHRIS2026
# Demo cookie auth (presets). Off on public prod; true on preview/staging for ops.
ENABLE_DEMO_AUTH=true
# Optional comma-separated admin emails when demo auth is on (empty = allow all admin logins)
# ADMIN_EMAILS=admin@astrolink.ai

# --- App session encryption (generate: openssl rand -hex 32) ---
ENCRYPTION_KEY=
# Legacy name in docs only — app reads ENCRYPTION_KEY
SESSION_SECRET=

# --- Stripe ---
# See docs/how-to/stripe-production-cutover.md for the full sandbox → production guide.

# Sandbox (AstroLink sandbox) — local dev + Vercel Preview
STRIPE_SECRET_KEY=          # sk_test_... from the AstroLink sandbox (or use stripe listen for local)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_test_... from the AstroLink sandbox
STRIPE_WEBHOOK_SECRET=      # whsec_... printed by `stripe listen`, or from the sandbox webhook

# Production (Live mode on the same account) — put these ONLY in Vercel Production envs
# STRIPE_SECRET_KEY=          # rk_live_... (Restricted API Key / RAK — never a full secret key)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=   # pk_live_...
# STRIPE_WEBHOOK_SECRET=      # whsec_... from the Live webhook endpoint

# Skip Stripe entirely — auto-confirms booking and runs APX-02 briefing (local AI testing / E2E only)
SKIP_STRIPE_PAYMENTS=true

# Production builds hard-disable SKIP_STRIPE_PAYMENTS. The AstroLink sandbox keeps test data isolated.

# Mentor Stripe Connect payouts — false at launch (manual ops payouts). Set true on Preview/staging
# when testing Connect onboarding + Express dashboard links; production when ops enables Connect.
ENABLE_STRIPE_CONNECT_PAYOUTS=false

# Booking rate limits (authenticated; applied to /api/book and /api/bookings/*/cancel)
# BOOKING_RATE_LIMIT_ENABLED=true
# BOOKING_MAX_REQUESTS_PER_MINUTE=5
# BOOKING_MAX_REQUESTS_PER_HOUR=20
# BOOKING_CANCEL_MAX_REQUESTS_PER_MINUTE=3
# BOOKING_CANCEL_MAX_REQUESTS_PER_HOUR=10

# E2E / Playwright — return fixture JSON from e2e/fixtures/briefing-stub.json (non-production only)
# E2E_STUB_LLM=true

# --- LLM (APX agents) — Gemini primary (Build with Gemini XPRIZE) ---
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# GEMINI_FLASH_MODEL=gemini-flash-latest
# GEMINI_PRO_MODEL=gemini-flash-latest

# OpenAI (optional fallback — set LLM_PROVIDER=openai when OPENAI_API_KEY is set)
# OPENAI_API_KEY=
# OPENAI_FLASH_MODEL=gpt-4o-mini
# OPENAI_PRO_MODEL=gpt-4o

# Early-access signup rate limits (Supabase buckets when service role is set; in-memory fallback)
# EARLY_ACCESS_RATE_LIMIT_ENABLED=true
# EARLY_ACCESS_DURABLE_RATE_LIMIT=true
# EARLY_ACCESS_MAX_REQUESTS_PER_MINUTE=5
# EARLY_ACCESS_MAX_REQUESTS_PER_HOUR=30
# EARLY_ACCESS_MAX_REQUESTS_PER_EMAIL_HOUR=3

# LLM rate limits (protect API key spend; in-memory per server instance)
# LLM_RATE_LIMIT_ENABLED=true
# LLM_MAX_REQUESTS_PER_MINUTE=10
# LLM_MAX_REQUESTS_PER_HOUR=60
# LLM_MAX_REQUESTS_PER_DAY=200
# LLM_MAX_REQUESTS_PER_USER_HOUR=5
# LLM_MAX_REQUESTS_PER_USER_DAY=15
# Live caption segment translation (per booking, keyed to mentee_id; higher defaults)
# LLM_MAX_CAPTION_REQUESTS_PER_MINUTE=60
# LLM_MAX_CAPTION_REQUESTS_PER_HOUR=300
# LLM_MAX_CAPTION_REQUESTS_PER_DAY=1000

# --- Booking notifications (APX-08 / Resend) ---
# RESEND_API_KEY=re_...
# RESEND_FROM=AstroLink <notifications@astro-link.space>
# Disable outbound email (E2E default; set false locally to test real sends)
NOTIFICATIONS_DISABLED=true

# --- Daily.co (live video) ---
DAILY_API_KEY=
# Explicit opt-in for room creation (production/demo). Without true, rooms are never provisioned.
DAILY_PROVISION_ENABLED=false
# Demo guardrails (room + token props; join-window gates in app)
# DAILY_MAX_PARTICIPANTS=2
# DAILY_ROOM_JOIN_WINDOW_BEFORE_MINUTES=15
# DAILY_ROOM_JOIN_WINDOW_AFTER_MINUTES=60
# DAILY_MAX_CALL_MINUTES=35
# Webhook HMAC secret from Daily dashboard (base64) — meeting.ended + transcript.ready-to-download
DAILY_WEBHOOK_HMAC=
# When true: mentor tokens auto-start transcription; APX-03 runs on transcript.ready (not meeting.ended)
# Required for live caption rail in dev (Phase 3). E2E pins false; stub path uses E2E_STUB_LLM seam.
DAILY_TRANSCRIPTION_ENABLED=false
