# =============================================================================
# AstroLink — copy to .env.local and fill in values
# Supabase project: AstroLink (ref vwoizjesyyygmokfqpyy)
# Dashboard: https://supabase.com/dashboard/project/vwoizjesyyygmokfqpyy
# =============================================================================

# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://vwoizjesyyygmokfqpyy.supabase.co
# Publishable (recommended) or legacy anon key — client-safe only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only (agents, API routes). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App mode (production waitlist: APP_MODE=waitlist) ---
# waitlist = public /early-access only; full = dev/booking surfaces
APP_MODE=full
# Demo cookie auth (presets). Off on public prod; true on preview/staging for ops.
ENABLE_DEMO_AUTH=true
# Optional comma-separated admin emails when demo auth is on (empty = allow all admin logins)
# ADMIN_EMAILS=admin@astrolink.ai

# --- App session encryption (generate: openssl rand -hex 32) ---
ENCRYPTION_KEY=
# Legacy name in docs only — app reads ENCRYPTION_KEY
SESSION_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Local checkout without mentor Connect onboarding (platform-only PI)
STRIPE_BOOKING_TEST_MODE=true
# Skip Stripe entirely — auto-confirms booking and runs APX-02 briefing (local AI testing)
SKIP_STRIPE_PAYMENTS=true

# E2E / Playwright — return fixture JSON from e2e/fixtures/briefing-stub.json (non-production only)
# E2E_STUB_LLM=true

# --- LLM (APX agents) — OpenAI default when OPENAI_API_KEY is set ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
# OPENAI_FLASH_MODEL=gpt-4o-mini
# OPENAI_PRO_MODEL=gpt-4o

# Gemini (optional — set LLM_PROVIDER=gemini to use)
# GEMINI_API_KEY=
# GEMINI_FLASH_MODEL=gemini-2.0-flash
# GEMINI_PRO_MODEL=gemini-2.0-flash

# Early-access signup rate limits (in-memory per server instance)
# EARLY_ACCESS_RATE_LIMIT_ENABLED=true
# EARLY_ACCESS_MAX_REQUESTS_PER_MINUTE=5
# EARLY_ACCESS_MAX_REQUESTS_PER_HOUR=30

# LLM rate limits (protect API key spend; in-memory per server instance)
# LLM_RATE_LIMIT_ENABLED=true
# LLM_MAX_REQUESTS_PER_MINUTE=10
# LLM_MAX_REQUESTS_PER_HOUR=60
# LLM_MAX_REQUESTS_PER_DAY=200
# LLM_MAX_REQUESTS_PER_USER_HOUR=5
# LLM_MAX_REQUESTS_PER_USER_DAY=15

# --- Daily.co (live video) ---
DAILY_API_KEY=
# Explicit opt-in for room creation (production/demo). Without true, rooms are never provisioned.
DAILY_PROVISION_ENABLED=false
# Demo guardrails (room + token props; join-window gates in app)
# DAILY_MAX_PARTICIPANTS=2
# DAILY_ROOM_JOIN_WINDOW_BEFORE_MINUTES=15
# DAILY_ROOM_JOIN_WINDOW_AFTER_MINUTES=60
# DAILY_MAX_CALL_MINUTES=35
# Webhook HMAC secret from Daily dashboard (base64) — meeting.ended + transcript.ready-to-download
DAILY_WEBHOOK_HMAC=
# When true: mentor tokens auto-start transcription; APX-03 runs on transcript.ready (not meeting.ended)
# Required for live caption rail in dev (Phase 3). E2E pins false; stub path uses E2E_STUB_LLM seam.
DAILY_TRANSCRIPTION_ENABLED=false
