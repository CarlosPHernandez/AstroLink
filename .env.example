# --- Supabase (Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://vwoizjesyyygmokfqpyy.supabase.co
# Publishable (recommended) or legacy anon key — client-safe only
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role — server only (agents, API routes). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- App session encryption (generate: openssl rand -hex 32) ---
SESSION_SECRET=

# --- Stripe ---
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Local checkout without mentor Connect onboarding (platform-only PI)
STRIPE_BOOKING_TEST_MODE=true

# --- Google Gemini (APX agents) ---
GOOGLE_GENERATIVE_AI_API_KEY=

# --- Daily.co (live video) ---
DAILY_API_KEY=
